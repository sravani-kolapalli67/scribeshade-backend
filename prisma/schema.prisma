generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  Easy
  Medium
  Hard
}

enum Industry {
  DSA
  Full_Stack
  Data_Science
  DevOps
  System_Design
  Mobile
  Cloud
}

enum Language {
  JavaScript
  TypeScript
  Python
  Java
  C_Plus_Plus
  C
  C_Sharp
  Go
  General
}

// ─── Credit system enums ──────────────────────────────────────────────────────

enum SessionStatus {
  PRE_CHECK
  ACTIVE
  PAUSED
  DISCONNECTED    // Client gone; reconnectable within 5-min window
  COMPLETING
  COMPLETED
  ABANDONED
  FORCE_ENDED
  CREDIT_EXHAUSTED
  AUTO_ENDED      // Auto-terminated after 5-min disconnection; credits processed
}

enum LedgerType {
  DEBIT
  PURCHASE
  REFUND
  EARN
}

enum DeductionReason {
  FREE_ZONE
  HALF_BRACKET
  FULL_BRACKET
  EXHAUSTED
  FORCE_ENDED
  REFUND
  BRACKET_OVERFLOW
  PER_MINUTE_DEDUCTION
  CAP_REACHED
  ABANDONED
  AUTO_ENDED
}

enum PurchaseStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum PackFeature {
  INTERVIEW_SESSION
}

enum SupportedCurrency {
  INR
  USD
  GBP
}

enum PackTier {
  QUICK
  STARTER
  BASIC
  STANDARD
  PROFESSIONAL
  POWER
  MEGA
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ChunkType {
  QUESTION @map("question")
  ANSWER   @map("answer")
  CONTEXT  @map("context")
  SYSTEM   @map("system")
}

enum MessageRole {
  USER      @map("user")
  ASSISTANT @map("assistant")
  SYSTEM    @map("system")
}

enum SpeakerType {
  INTERVIEWER @map("interviewer")
  CANDIDATE   @map("candidate")
  SYSTEM      @map("system")
  ASSISTANT   @map("assistant")
}



model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumes   Resume[]
  sessions  Session[]
  documents Document[]
  questions QA[]

  projects  Project[]
  creditUsages CreditUsage[]
  builtResumes BuiltResume[]
  // Ask AI relations
  transcriptChunks TranscriptChunk[]
  askAiMessages    AskAiMessage[]
  // Assistant module
  assistantChats   AssistantChat[]
  // Credit system relations
  creditBalance UserCreditBalance?
  ledgerEntries CreditLedger[]
  purchases     CreditPurchase[]
  idempotencyKeys IdempotencyKey[]
  aiGenerationCache AiGenerationCache[]
}

model Resume {
  id            String   @id @default(uuid())
  filename      String
  path          String
  size          Int?
  resumeContext String?
  uploadedAt    DateTime @default(now())

  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  ats        Boolean      @default(false)
  parsedData Json?
  metadataIndex Json?
  atsAnalysis ATSAnalysis?
}

model Document {
  id         String   @id @default(uuid())
  filename   String
  path       String
  size       Int?
  uploadedAt DateTime @default(now())

  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ATSAnalysis {
  id              String   @id @default(uuid())
  score           Int
  summary         String
  strengths       String[]
  weaknesses      String[]
  missingKeywords String[]
  suggestions     String[]
  createdAt       DateTime @default(now())

  resumeId String @unique
  resume   Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model BuiltResume {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  templateId     String
  fields         Json
  sections       Json
  jobDescription String?  @db.Text
  jobTitle       String?
  company        String?
  /// "draft" until saved-clean + downloaded; then "completed"
  status         String   @default("draft")
  downloadedAt   DateTime?
  /// ATS score persisted after the last builder ATS scan (0-100)
  atsScore       Int?
  /// Full ATS result object persisted after the last builder ATS scan
  lastAtsResult  Json?
  /// Timestamp of the last ATS scan
  lastAtsAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model ResumeTemplate {
  id        String   @id @default(uuid())
  name      String
  category  String
  thumbnail String
  code      String   @db.Text
  createdAt DateTime @default(now())
}

model Company {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  logo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions  Session[]
  questions QA[]
}

model Session {
  id                   String   @id @default(uuid())

  companyId            String
  companyName          String
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  jobDescription       String
  resumeId             String
  documentId           String   @map("DocumentId")
  language             String
  simpleLanguage       Boolean @default(true)
  extraContext         String
  autoGenerateResponse Boolean
  saveTranscription    Boolean
  free                 Boolean
  mode                 String

  // ── status (replaces isActive Boolean) ───────────────────────────────────
  status                SessionStatus @default(PRE_CHECK)

  // ── timing ────────────────────────────────────────────────────────────────
  startedAt             DateTime?
  endedAt               DateTime?
  durationSeconds       Int?
  pausedDurationSeconds Int           @default(0)
  lastHeartbeatAt       DateTime?     // Updated on every heartbeat ping; used by watchdog to detect stale sessions
  disconnectedAt        DateTime?     // When the watchdog first detected the client was gone

  // ── credit fields ──────────────────────────────────────────────────────────
  creditsHeld           Decimal       @db.Decimal(10, 2) @default(0)  // Always 0 — hold system removed; kept for backward compat with existing rows
  creditsDeducted       Decimal?      @db.Decimal(10, 2)
  deductionReason       DeductionReason?
  bracketConfigSnapshot Json?         // Snapshot of pricing config at activation time
  maxAllowedMinutes     Int?          // Soft cap computed from balance at activation
  creditExhaustedAt     DateTime?

  aiUsage Int @default(0)

  // ── optional AI-project context IDs selected at session creation ───────────
  primaryProjectId String?
  projectIds Json @default("[]")

  messages   Json @default("[]")
  transcript Json @default("[]")

  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  questions QA[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feedback SessionFeedback?
  notes    SessionNotes?
  transcriptChunks TranscriptChunk[]
  askAiMessages    AskAiMessage[]
  snapshots        AnswerGenerationSnapshot[]
  topicMemories    SessionTopicMemory[]
  turnMemories     SessionTurnMemory[]
  candidateDigest  CandidateContextDigest?

  @@index([userId, createdAt(sort: Desc)])
  @@index([companyId])
  @@index([status])
}


model QA {
  id String @id @default(uuid())

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  ques       String
  answer     String?
  difficulty Difficulty @default(Easy)
  industry   Industry   @default(DSA)
  language   Language   @default(General)
  isShared   Boolean    @default(false)

  userId String?
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([sessionId])
  @@index([userId])
  @@index([isShared])
}

model Project {
  id              String   @id @default(uuid())
  position        String
  industry        String?
  experienceLevel String?
  jobDescription  String   @db.Text
  resumeId        String?
  
  projects        Json     // Stores the array of generated projects (current version)
  
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions        ProjectVersion[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// Immutable snapshot of a Project's `projects` JSON before each regeneration.
// Version 1 = original, version 2 = after first regen, etc.
model ProjectVersion {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  versionNumber Int              // 1-based; auto-incremented per projectId
  projects      Json             // Snapshot of projects array at this point in time
  label         String?          // Optional human-readable label, e.g. "Before regen 2026-05-05"

  createdAt   DateTime @default(now())

  @@index([projectId])
  @@unique([projectId, versionNumber])
}

model SessionFeedback {
  id              String   @id @default(uuid())
  sessionId       String   @unique
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  // High-level Metrics
  score           Int      
  confidence      Int      
  sessionQuality  String   
  verdict         String   
  
  // Detailed Scores
  communication   Int
  interactivity   Int
  technicalDepth  Int
  conciseness     Int
  
  // Stats
  avgResponseLen  Int      
  answeredCount   Int      
  aiAssistsCount  Int      
  avgResponseTime Float    
  
  // Qualitative Feedback
  strengths       String[] 
  improvements    String[] 
  interviewerMood String   
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SessionNotes {
  id              String   @id @default(uuid())
  sessionId       String   @unique
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  companyName     String
  jobDescription  String   @db.Text
  summary         String   @db.Text
  questions       Json     // Array of questions asked in the session
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SessionTopicMemory {
  id             String              @id @default(uuid())
  sessionId      String
  session        Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  topicTitle     String
  topicKeywords  String[]
  currentSummary String              @db.Text
  lastQuestion   String?             @db.Text
  lastAnswer     String?             @db.Text
  active         Boolean             @default(true)
  startedAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  turnMemories   SessionTurnMemory[]

  @@index([sessionId, active])
  @@index([sessionId, updatedAt])
}

model SessionTurnMemory {
  id                String              @id @default(uuid())
  sessionId         String
  session           Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  transcriptChunkId String?
  topicId           String?
  topic             SessionTopicMemory? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  questionRaw       String              @db.Text
  questionClean     String              @db.Text
  answerRaw         String              @db.Text
  answerSummary     String              @db.Text
  answerType        String
  codeBlocks        Json?
  keyClaims         String[]
  followupKeys      String[]
  createdAt         DateTime            @default(now())

  @@index([sessionId, createdAt])
  @@index([sessionId, topicId, createdAt])
}

model CandidateContextDigest {
  id              String   @id @default(uuid())
  sessionId       String   @unique
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  resumeId        String
  documentId      String?
  projectIds      String[]
  sourceHash      String
  status          String   @default("READY")
  errorMessage    String?  @db.Text
  resumeDigest    String   @db.Text
  skills          String[]
  projectCards    Json
  experienceFacts Json
  domainKeywords  String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sourceHash])
  @@index([status])
}

// ─── Credit system models ─────────────────────────────────────────────────────

/// Purchasable credit pack definitions — replaces the hardcoded INTERVIEW_PACKS array.
/// Each row is one pack. Prices per currency are stored as normalised Decimal columns.
/// Soft-delete via `isActive`; no FK relations needed (packs are catalogue data).
model CreditPack {
  id          String      @id @default(uuid())

  /// Machine-readable identifier, e.g. "quick_5". Unique — used as the stable
  /// reference in Razorpay receipts, the CreditPurchase.packName field, and URLs.
  code        String      @unique

  /// Enum tier — drives ordering and badge logic on the frontend.
  tier        PackTier

  /// Display name shown in the UI, e.g. "Quick 5".
  name        String

  /// Number of credits the user receives on purchase.
  credits     Decimal     @db.Decimal(10, 2)

  /// Which product feature these credits are valid for.
  feature     PackFeature @default(INTERVIEW_SESSION)

  /// Prices in each supported currency (major units, e.g. "99.00").
  priceInr    Decimal     @db.Decimal(10, 2)
  priceUsd    Decimal     @db.Decimal(10, 2)
  priceGbp    Decimal     @db.Decimal(10, 2)

  /// Optional "value / discount" percentage shown on the card (0–100).
  /// Computed externally and stored here so it can be tweaked without code changes.
  valuePct    Int         @default(0)

  /// Whether this pack is shown in the purchase UI.
  isActive    Boolean     @default(true)

  /// Whether to show a "Popular" badge on the card.
  isPopular   Boolean     @default(false)

  /// Display order in the pricing grid (ascending).
  sortOrder   Int         @default(0)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([isActive])
  @@index([tier])
}

model CreditConfig {
  id                String   @id @default(uuid())
  bracketMinutes    Int      @unique
  creditsFull       Decimal  @db.Decimal(10, 2)
  creditsHalf       Decimal  @db.Decimal(10, 2)
  creditsPerMinute  Decimal  @db.Decimal(10, 4) @default(0.5)
  graceZoneMinutes  Int      @default(5)
  isActive          Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

/// Configurable credit cost per product feature.
/// Update rows here to change pricing without a code deploy.
model FeatureCost {
  id         String   @id @default(uuid())
  featureKey String   @unique  // e.g. "project_generate", "project_edit_component"
  credits    Decimal  @db.Decimal(10, 2)
  label      String   // Human-readable description shown in ledger
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model UserCreditBalance {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchasedCredits Decimal  @db.Decimal(10, 2) @default(0)
  earnedCredits    Decimal  @db.Decimal(10, 2) @default(0)
  heldCredits      Decimal  @db.Decimal(10, 2) @default(0)
  totalAvailable   Decimal  @db.Decimal(10, 2) @default(0)
  lastUpdated      DateTime @updatedAt
}

model CreditLedger {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     String?
  type          LedgerType
  amount        Decimal    @db.Decimal(10, 2)
  balanceBefore Decimal    @db.Decimal(10, 2)
  balanceAfter  Decimal    @db.Decimal(10, 2)
  reason        String
  createdAt     DateTime   @default(now())

  @@index([userId])
  @@index([sessionId])
}

model CreditPurchase {
  id                     String         @id @default(uuid())
  userId                 String
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  packName               String
  creditsPurchased       Decimal        @db.Decimal(10, 2)
  creditsRemaining       Decimal        @db.Decimal(10, 2)
  paymentProviderEventId String         @unique
  amountPaid             Decimal        @db.Decimal(10, 2)
  currency               String         @default("USD")
  status                 PurchaseStatus @default(PENDING)
  createdAt              DateTime       @default(now())
  confirmedAt            DateTime?

  @@index([userId])
}

model CreditUsage {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId    String?
  operation   String
  creditsUsed Decimal  @db.Decimal(10, 2)
  aiModel     String?
  aiCostUsd   Decimal? @db.Decimal(10, 4)
  inputTokens Int?
  outputTokens Int?
  cached      Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([resumeId])
  @@index([operation])
}

model Policy {
    id String @id @default(uuid())
    privacyPolicy String @db.Text
    termsAndConditions String @db.Text
    updatedAt DateTime @default(now())
}

// ─── AI credit metering — request-level idempotency + result cache ────────────

/// Request-level idempotency for AI credit-deducting endpoints.
/// Clients send an `Idempotency-Key` header (UUID v4) per logical action.
/// The wrapper inserts a row in IN_PROGRESS state, executes the AI call, then
/// transitions to COMPLETED (with cached response) or FAILED. Concurrent
/// duplicate requests collide on the unique `key` and short-circuit to the
/// cached response, guaranteeing a user is never billed twice for one click.
model IdempotencyKey {
  key          String            @id
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  operation    String            // e.g. "RESUME_ENHANCE_SECTION"
  status       IdempotencyStatus @default(IN_PROGRESS)
  responseBody Json?             // Cached successful response payload
  statusCode   Int?              // HTTP status code of the cached response
  creditsUsed  Decimal?          @db.Decimal(10, 2)
  createdAt    DateTime          @default(now())
  completedAt  DateTime?
  expiresAt    DateTime          // 24h TTL — older rows safe to GC

  @@index([userId])
  @@index([expiresAt])
  @@index([operation])
}

/// Caches successful AI generation results so repeat operations (e.g. JD
/// tailor "regenerate") can be served free. Keyed by (user, resume, op,
/// inputHash). The wrapper looks up by hash before deducting credits; a hit
/// returns the cached payload with `creditsUsed: 0` and `cached: true`.
model AiGenerationCache {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId       String   @default("") // "" means "not scoped to a resume"
  operation      String   // e.g. "RESUME_TAILOR"
  inputHash      String   // SHA-256 of normalized inputs
  responseBody   Json
  creditsCharged Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  expiresAt      DateTime // 24h TTL

  @@unique([userId, operation, resumeId, inputHash])
  @@index([userId])
  @@index([expiresAt])
}

model TranscriptChunk {
  id              String   @id @default(uuid())
  sessionId       String
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  questionId      String?
  question        String?  @db.Text
  aiAnswer        String?  @db.Text
  content         String   @db.Text // The chunk content (transcript text)
  
  technologies    String[]
  difficulty      String?  
  
  startTime       Float?
  endTime         Float?
  speakerType     SpeakerType?  // interviewer, candidate


  
  // pgvector field - dimension for perplexity/pplx-embed-v1-4b
  embedding       Unsupported("vector(2560)")?


  questionGroupId String?
  chunkOrder      Int?
  isQuestion      Boolean @default(false)
  chunkType       ChunkType?

  createdAt       DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([sessionId, chunkOrder])
  @@index([sessionId, questionGroupId])
  @@index([sessionId, speakerType, createdAt])
  @@index([userId])
}


model AskAiMessage {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  role      MessageRole
  content   String   @db.Text


  
  citations Json?    // Array of TranscriptChunk metadata

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([userId])
}

// ─── Assistant Module ──────────────────────────────────────────────────────────

model AssistantChat {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String             @default("New Chat")
  sessionId String?            // Optional: narrow to a specific session
  messages  AssistantMessage[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
}

model AssistantMessage {
  id        String        @id @default(uuid())
  chatId    String
  chat      AssistantChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId    String
  role      MessageRole
  content   String        @db.Text
  citations Json?
  createdAt DateTime      @default(now())

  @@index([chatId, createdAt])
  @@index([userId])
}

model AnswerGenerationSnapshot {
  id                         String   @id @default(uuid())
  sessionId                  String
  session                    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  originalQuestionTranscript String   @db.Text
  transcriptWindowBefore     Json     @default("[]") // string[]
  transcriptWindowActive     String   @db.Text       // string
  transcriptWindowAfter      Json     @default("[]") // string[]
  timestampRangeStart        Float
  timestampRangeEnd          Float
  selectedResumeContext      String?  @db.Text
  selectedProjectContext     Json?    @default("[]") // string[]
  selectedDocumentContext    Json?    @default("[]") // string[]
  ragContext                 Json?    @default("[]") // string[]
  generatedAnswer            String   @db.Text
  modelUsed                  String
  fromTranscriptChunkId      String?
  toTranscriptChunkId        String?
  detectedIntent             String?
  resolvedIntentIds          String[] @default([])
  questionGenerated          String?  @db.Text
  sessionStateSummary        String?  @db.Text
  confidence                 Float?
  decisionMetadata           Json?    @default("{}")
  createdAt                  DateTime @default(now())

  @@index([sessionId])
  @@index([sessionId, createdAt])
}
